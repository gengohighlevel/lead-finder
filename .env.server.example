# The app. Copy to .env.server on the server and fill in. Never commit the real file.

# --- LOGIN. Option 1: the app's own login (use this when the domain's DNS is not on Cloudflare).
# Do not fill these by hand: run `npm run login:create` ON YOUR COMPUTER; it writes them into .env.server for you.
# AUTH_MODE=password, ADMIN_EMAIL, ADMIN_PASSWORD_HASH, ADMIN_TOTP_SECRET, SESSION_SECRET, RECOVERY_CODE_HASHES
#
# --- hosted mode: the public name(s) the app answers to, and the Cloudflare Access login that protects it ---
APP_HOSTS=leads.yourdomain.com
CF_ACCESS_TEAM=yourteam                # the part before .cloudflareaccess.com
CF_ACCESS_AUD=                         # the Application Audience (AUD) tag of your Access application
ACCESS_EMAILS=you@yourdomain.com       # optional extra check: only these emails (comma separated)

# --- GoHighLevel and the Australian business register ---
GHL_TOKEN=
GHL_LOCATION_ID=
ABN_GUID=

# --- AI writer: leave empty on a cheap server (no graphics chip); outreach then uses the accurate playbook templates ---
OLLAMA_URL=

# Email drafts: sign-off and the opt-out footer (required by AU/UK/NZ rules). Name, business, address and reply email must ALL be set
# for the footer to be added; SENDER_PRIVACY_URL is used in the UK footer.
SENDER_NAME=
SENDER_TITLE=
SENDER_PROOF=
SENDER_BUSINESS=
SENDER_ADDRESS=
SENDER_EMAIL=
SENDER_PRIVACY_URL=
# SENDER_PROOF: one TRUE line of proof (a real result or similar client) added to every draft, e.g. 'I helped a Brisbane clinic cut no-shows.' Leave empty for none; the app never invents one.
